generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // Runtime traffic goes through the transaction pooler (pgbouncer);
  // migrations need a direct/session connection.
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  username           String               @unique
  password           String
  firstName          String?
  lastName           String?
  preferredLanguage  String               @default("en")
  learningLanguage   String?
  proficiencyLevel   String?
  dailyGoalMinutes   Int?
  isPremium          Boolean              @default(false)
  streakFreezes      Int                  @default(1)
  streakFreezeDates  Json                 @default("[]")
  streakFreezeMilestone Int               @default(0)
  lastReEngagementEmailAt DateTime?
  emailVerified         Boolean           @default(false)
  verificationCode      String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int               @default(0)
  resetCode             String?
  resetExpiresAt        DateTime?
  resetAttempts         Int               @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  enrollments        CourseEnrollment[]
  lessons            LessonProgress[]
  goals              LearningGoal[]
  vocabularyProgress VocabularyProgress[]
  sessions           LearningSession[]
  interactions       LearningInteraction[]
  speechSessions     SpeechSession[]
  certificates       Certificate[]
  quizAttempts       QuizAttempt[]
  achievements       Achievement[]
  createdCourses     Course[]             @relation("CourseInstructor")
  learningPaths      LearningPath[]
  pathEnrollments    PathEnrollment[]
  skillSessions      SkillSession[]
  submittedSentences SentenceSubmission[] @relation("SubmittedSentences")
  givenCorrections   SentenceCorrection[] @relation("GivenCorrections")
  audioContributions AudioContribution[]  @relation("AudioContributions")
  ownedSpaces        Space[]              @relation("OwnedSpaces")
  spaceMemberships   SpaceMembership[]    @relation("SpaceMemberships")
  channelMessages    ChannelMessage[]     @relation("ChannelMessages")
  debateRequests     DebateRequest[]      @relation("DebateRequests")
}

model Course {
  id                String             @id @default(uuid())
  title             String             @unique
  description       String
  level             String
  category          String             @default("LANGUAGE")
  estimatedDuration Int
  price             Float              @default(0)
  status            String             @default("PUBLISHED")
  imageUrl          String?
  tags              String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  instructorId      String?
  instructor        User?              @relation("CourseInstructor", fields: [instructorId], references: [id])
  lessons           Lesson[]
  enrollments       CourseEnrollment[]
  certificates      Certificate[]
  pathSteps         PathStep[]

  @@index([status, category, level])
}

model Lesson {
  id          String           @id @default(uuid())
  courseId    String
  title       String
  description String
  order       Int
  duration    Int
  type        String           @default("VIDEO")
  content     Json?
  status      String           @default("PUBLISHED")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  course      Course           @relation(fields: [courseId], references: [id])
  progress    LessonProgress[]
  quizzes     Quiz[]

  @@index([courseId, status, order])
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  isCompleted Boolean  @default(false)
  progress    Float    @default(0)
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId, enrolledAt(sort: Desc)])
  @@index([courseId])
}

model LessonProgress {
  id                   String   @id @default(uuid())
  userId               String
  lessonId             String
  status               String   @default("NOT_STARTED")
  completionPercentage Float    @default(0)
  timeSpentMinutes     Int      @default(0)
  attempts             Int      @default(0)
  lastAccessedAt       DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id])
  lesson               Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, lastAccessedAt(sort: Desc)])
  @@index([lessonId])
}

model LearningPath {
  id                String           @id @default(uuid())
  title             String
  description       String?          @db.Text
  difficulty        String           @default("BEGINNER")
  creatorId         String
  status            String           @default("DRAFT")
  tags              String           @default("[]")
  prerequisites     String           @default("[]")
  estimatedDuration Int?             @default(0)
  publishedAt       DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  creator           User             @relation(fields: [creatorId], references: [id])
  steps             PathStep[]
  enrollments       PathEnrollment[]
}

model PathStep {
  id            String       @id @default(uuid())
  pathId        String
  courseId      String?
  title         String
  description   String?      @db.Text
  order         Int
  isRequired    Boolean      @default(true)
  estimatedTime Int?         @default(0)
  metadata      Json?
  learningPath  LearningPath @relation(fields: [pathId], references: [id])
  course        Course?      @relation(fields: [courseId], references: [id])
}

model PathEnrollment {
  id            String       @id @default(uuid())
  userId        String
  pathId        String
  progress      Int          @default(0)
  status        String       @default("ACTIVE") // ACTIVE, COMPLETED
  enrolledAt    DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  learningPath  LearningPath @relation(fields: [pathId], references: [id])

  @@unique([userId, pathId])
}

model LearningGoal {
  id        String   @id @default(uuid())
  userId    String
  goals     String   @default("[]") // JSON string of goals
  timeframe String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model DictionaryLookup {
  id            String   @id @default(uuid())
  word          String
  language      String   @default("en")
  definition    String?
  pronunciation String?
  partOfSpeech  String?
  examples      String?  @db.Text // JSON string
  synonyms      String?  @db.Text // JSON string
  antonyms      String?  @db.Text // JSON string
  etymology     String?  @db.Text
  frequency     Float?
  difficulty    Int?
  source        String?  @default("free_dictionary")
  accessedCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([word, language])
  @@index([language, accessedCount])
}

model VocabularyItem {
  id            String               @id @default(uuid())
  word          String
  language      String
  definition    String?
  partOfSpeech  String?
  difficulty    Int?                 @default(1)
  tags          String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userProgress  VocabularyProgress[]
  audioContributions AudioContribution[]

  @@index([language, difficulty])
}

model VocabularyProgress {
  id               String         @id @default(uuid())
  userId           String
  vocabularyItemId String
  status           String         @default("NEW") // NEW, LEARNING, MASTERED
  masteryLevel     Int            @default(0) // 0-100
  lastEncountered  DateTime?
  nextReviewAt     DateTime?
  correctCount     Int            @default(0)
  incorrectCount   Int            @default(0)
  streak           Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id])
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id])

  @@unique([userId, vocabularyItemId])
  @@index([userId, nextReviewAt])
}

model RolePlayScenario {
  id           String            @id @default(uuid())
  title        String
  description  String
  category     String
  difficulty   Int               @default(1)
  instructions String?           @db.Text
  isLocked     Boolean           @default(false)
  isPremium    Boolean           @default(false)
  tags         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     LearningSession[]

  @@index([category])
}

model TechnologyTopic {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  category    String   // AI_BASICS, PROGRAMMING, DRONES, BIOMEDICAL, IOT, etc.
  difficulty  Int      @default(1)
  tags        String   @default("[]") // JSON string
  isLocked    Boolean  @default(false)
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    LearningSession[]

  @@index([category])
}

model LearningSession {
  id          String                @id @default(uuid())
  userId      String
  scenarioId  String?
  topicId     String?
  type        String                @default("CONVERSATION") // CONVERSATION, ROLEPLAY, TUTOR
  language    String                @default("en")
  status      String                @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  feedback    String?               @db.Text
  score       Int?
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  user        User                  @relation(fields: [userId], references: [id])
  scenario    RolePlayScenario?     @relation(fields: [scenarioId], references: [id])
  topic       TechnologyTopic?      @relation(fields: [topicId], references: [id])
  interactions LearningInteraction[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([topicId])
}

model LearningInteraction {
  id              String          @id @default(uuid())
  sessionId       String
  userId          String
  role            String          // USER, ASSISTANT
  content         String          @db.Text
  audioUrl        String?
  grammarErrors   Json?           // Structured grammar analysis
  nativeVersion   String?         @db.Text
  createdAt       DateTime        @default(now())
  session         LearningSession @relation(fields: [sessionId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId, createdAt(sort: Desc)])
}

model SpeechSession {
  id               String    @id @default(uuid())
  userId           String
  targetLanguage   String
  audioUrl         String
  transcription    String?   @db.Text
  translation      String?   @db.Text
  confidence       Float?
  duration         Int?      @default(0)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
  assessment       SpeechAssessment?

  @@index([userId, createdAt(sort: Desc)])
}

model SpeechAssessment {
  id                 String        @id @default(uuid())
  speechSessionId    String        @unique
  overallScore       Float
  pronunciationScore Float
  fluencyScore       Float
  clarityScore       Float
  wordScores         Json?         // Detailed word-level scores
  feedback           String?       @db.Text
  improvementAreas   String?       @db.Text // JSON string
  strongPoints       String?       @db.Text // JSON string
  createdAt          DateTime      @default(now())
  speechSession      SpeechSession @relation(fields: [speechSessionId], references: [id])
}

model Certificate {
  id               String    @id @default(uuid())
  userId           String
  courseId         String?
  title            String
  description      String?   @db.Text
  type             String    // COMPLETION, SKILL_ASSESSMENT, etc.
  status           String    @default("ACTIVE") // ACTIVE, REVOKED
  issuerName       String    @default("VibeOn")
  issueDate        DateTime  @default(now())
  verifyCode       String    @unique
  metadata         Json?     // criteria, achievements, scores
  user             User      @relation(fields: [userId], references: [id])
  course           Course?   @relation(fields: [courseId], references: [id])

  @@index([userId])
}

model Quiz {
  id          String        @id @default(uuid())
  lessonId    String
  title       String
  description String?
  passingScore Int          @default(70)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lesson      Lesson        @relation(fields: [lessonId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]

  @@index([lessonId])
}

model Achievement {
  id              String   @id @default(uuid())
  userId          String
  title           String
  description     String?
  type            String   // COURSE_COMPLETION, STREAK, QUIZ_MASTER, etc.
  xpReward        Int      @default(0)
  unlockedAt      DateTime @default(now())
  metadata        Json?
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, unlockedAt(sort: Desc)])
}

model Question {
  id             String   @id @default(uuid())
  quizId         String
  text           String
  type           String   @default("MULTIPLE_CHOICE")
  options        Json?    // Array of options
  correctAnswer  String
  explanation    String?
  points         Int      @default(1)
  quiz           Quiz     @relation(fields: [quizId], references: [id])

  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  score       Int
  status      String    @default("COMPLETED")
  answers     Json?     // Array of user answers
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
  quiz        Quiz      @relation(fields: [quizId], references: [id])

  @@index([userId, completedAt(sort: Desc)])
  @@index([quizId])
}

model LearningPassage {
  id          String         @id @default(uuid())
  language    String
  level       String         // BEGINNER, INTERMEDIATE, ADVANCED
  contentType String         // WORDS (JSON array of ~12 words), PARAGRAPH (plain text)
  content     String         @db.Text
  topic       String?
  source      String         @default("ai_generated") // ai_generated | dictionary | seed
  createdAt   DateTime       @default(now())
  sessions    SkillSession[]

  @@index([language, level, contentType])
}

model SkillSession {
  id        String          @id @default(uuid())
  userId    String
  passageId String
  skill     String          // READING, LISTENING
  accuracy  Int             @default(0)
  mistakes  String?         @db.Text // JSON array of {expected, heard} mistake records
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
  passage   LearningPassage @relation(fields: [passageId], references: [id])

  @@index([userId, skill, createdAt(sort: Desc)])
  @@index([passageId])
}

// Scoped peer-correction ("Sentence Swap"): a learner submits one sentence
// a day, another learner ahead of them corrects it — deliberately not an
// open italki-style public feed, which is a moderation burden a solo
// founder can't sustain. See missingFeatures.md.
model SentenceSubmission {
  id         String              @id @default(uuid())
  userId     String
  language   String
  text       String              @db.Text
  status     String              @default("PENDING") // PENDING, CORRECTED
  createdAt  DateTime            @default(now())
  user       User                @relation("SubmittedSentences", fields: [userId], references: [id])
  correction SentenceCorrection?

  @@index([language, status, createdAt])
  @@index([userId, createdAt])
}

// Community-recorded pronunciation audio — a real alternative to TTS for
// core vocabulary, built up organically by learners recording themselves
// rather than sourced/licensed native-speaker audio (which nobody involved
// in building this app can actually produce). Deliberately NOT labeled
// "native speaker" anywhere — that's a claim this app has no way to verify.
// No object storage is wired up yet, so short clips are stored as base64
// directly (size-capped) — a real trade-off for a solo founder's MVP, not
// a shortcut meant to last forever.
model AudioContribution {
  id            String          @id @default(uuid())
  contributorId String
  word          String
  language      String
  vocabularyItemId String?
  audioData     String          @db.Text // base64-encoded clip, size-capped at submit time
  mimeType      String          @default("audio/webm")
  reportCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  contributor   User            @relation("AudioContributions", fields: [contributorId], references: [id])
  vocabularyItem VocabularyItem? @relation(fields: [vocabularyItemId], references: [id])

  @@index([word, language, reportCount])
  @@index([contributorId, createdAt])
}

model SentenceCorrection {
  id            String             @id @default(uuid())
  submissionId  String             @unique
  correctorId   String
  correctedText String             @db.Text
  note          String?            @db.Text
  createdAt     DateTime           @default(now())
  submission    SentenceSubmission @relation(fields: [submissionId], references: [id])
  corrector     User               @relation("GivenCorrections", fields: [correctorId], references: [id])

  @@index([correctorId])
}

// Spaces & Channels — built natively in Vibeon Learn (not an embedded
// third-party product). A Space is a community (public, listed in a
// directory and freely joinable — or private, joinable only via invite
// link). Each Space has Channels; a DEBATE channel is a moderated
// discussion where anyone can request to join as a participant, approved
// by the space's owner/moderators — async only for now (text/voice/image
// messages), live audio/video deferred to a later phase pending a WebRTC
// provider decision.
model Space {
  id          String            @id @default(uuid())
  name        String
  description String?           @db.Text
  visibility  String            @default("PUBLIC") // PUBLIC, PRIVATE
  ownerId     String
  createdAt   DateTime          @default(now())
  owner       User              @relation("OwnedSpaces", fields: [ownerId], references: [id])
  memberships SpaceMembership[]
  invites     SpaceInvite[]
  channels    Channel[]

  @@index([visibility, createdAt])
}

model SpaceMembership {
  id       String   @id @default(uuid())
  spaceId  String
  userId   String
  role     String   @default("MEMBER") // OWNER, MODERATOR, MEMBER
  joinedAt DateTime @default(now())
  space    Space    @relation(fields: [spaceId], references: [id])
  user     User     @relation("SpaceMemberships", fields: [userId], references: [id])

  @@unique([spaceId, userId])
  @@index([userId])
}

model SpaceInvite {
  id        String   @id @default(uuid())
  spaceId   String
  code      String   @unique
  createdBy String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id])

  @@index([spaceId])
}

model Channel {
  id             String           @id @default(uuid())
  spaceId        String
  name           String
  description    String?
  type           String           @default("TEXT") // TEXT, DEBATE
  order          Int              @default(1)
  createdAt      DateTime         @default(now())
  space          Space            @relation(fields: [spaceId], references: [id])
  messages       ChannelMessage[]
  debateRequests DebateRequest[]

  @@index([spaceId])
}

model ChannelMessage {
  id               String           @id @default(uuid())
  channelId        String
  userId           String
  type             String           @default("TEXT") // TEXT, VOICE, IMAGE
  text             String?          @db.Text
  mediaData        String?          @db.Text // base64, size-capped at submit time
  mimeType         String?
  parentMessageId  String?
  createdAt        DateTime         @default(now())
  channel          Channel          @relation(fields: [channelId], references: [id])
  user             User             @relation("ChannelMessages", fields: [userId], references: [id])
  parent           ChannelMessage?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies          ChannelMessage[] @relation("MessageReplies")

  @@index([channelId, createdAt])
  @@index([parentMessageId])
}

model DebateRequest {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  status    String   @default("PENDING") // PENDING, APPROVED, DECLINED
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id])
  user      User     @relation("DebateRequests", fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@index([channelId, status])
}
